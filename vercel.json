{
    "redirects": [
        {
            "source": "/",
            "destination": "/src/index.html",
            "permanent": false
        }
    ],
    "headers": [
        {
            "source": "/src/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600"
                }
            ]
        }
    ]
}